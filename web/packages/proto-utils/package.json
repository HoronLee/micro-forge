{
    "name": "@servora/proto-utils",
    "version": "0.1.6",
    "description": "Servora Proto 工具：CRUD 查询、FieldMask、ProtoJSON 与 Kratos 错误解析",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./crud": {
            "types": "./dist/crud/index.d.ts",
            "import": "./dist/crud/index.js"
        },
        "./proto/*": {
            "types": "./dist/gen/*/index.d.ts",
            "import": "./dist/gen/*/index.js"
        },
        "./error-reasons/*": {
            "types": "./dist/gen/*.errors.d.ts",
            "import": "./dist/gen/*.errors.js"
        },
        "./errors": {
            "types": "./dist/errors.d.ts",
            "import": "./dist/errors.js"
        }
    },
    "files": [
        "dist",
        "src",
        "!src/**/*_test.ts"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rm -rf dist",
        "typecheck": "tsc --noEmit",
        "typecheck:test": "tsc -p test/tsconfig.json",
        "test": "pnpm run build && pnpm run typecheck:test && node --test test/*.test.mjs",
        "prepublishOnly": "npm run clean && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Servora-Kit/servora.git",
        "directory": "web/packages/proto-utils"
    },
    "homepage": "https://github.com/Servora-Kit/servora/tree/main/web/packages/proto-utils",
    "bugs": {
        "url": "https://github.com/Servora-Kit/servora/issues"
    },
    "license": "MIT",
    "sideEffects": false,
    "devDependencies": {
        "typescript": "^5.7.2"
    }
}
